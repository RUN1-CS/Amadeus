# PostgreSQL
POSTGRES_IMAGE=pgvector/pgvector:pg17
POSTGRES_DB=amadeus
POSTGRES_USER=amadeus
POSTGRES_PASSWORD=change-this-password
# Generate once with: openssl rand -base64 32. Keep this secret and stable.
DATA_ENCRYPTION_KEY=

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192
UNLOAD_MODEL_BEFORE_IMAGE=false
KEEPT_ALIVE=30m

# Memory
MAX_MEMORY_RESULTS=6
MAX_MEMORY_CONTEXT_LENGTH=6000

# Tooling
MAX_TOOL_ROUNDS=8
MAX_TOOL_RESULT_CHARS=12000
MAX_TOOL_ERROR_CHARS=500
MIN_EVIDENCE_CHARS=400

# Image generation
TOKENS_PER_IMAGE=600

# ComfyUI
COMFYUI_BASE_URL=http://comfyui:18188
# A negative prompt for admins
COMFYUI_NEGATIVE_PROMPT=
COMFYUI_MODELS_PATH=/opt/ComfyUI/models
WEBUI_ENABLE_AUTH=true
WEBUI_USERNAME=admin
WEBUI_PASSWORD=change-this-password

# Port mappings (host ports)
# Use 0.0.0.0 to expose the server port to the LAN, or 127.0.0.1 for localhost only.
SERVER_BIND_ADDRESS=0.0.0.0
SERVER_PORT=8080
WEB_PORT=3000
SERVER_HEALTHCHECK_START_PERIOD=5m

# Sessions
TTL_MS=30000
MAX_ENTRIES=1000

# WebSocket
MAX_PAYLOAD_BYTES=26214400 # 25 * 1024 * 1024 / 25 MiB
HEARTBEAT_MS=30000

# PostgreSQL health check
POSTGRES_HEALTHCHECK_INTERVAL=5s
POSTGRES_HEALTHCHECK_TIMEOUT=5s
POSTGRES_HEALTHCHECK_RETRIES=10

# Database backups
DATABASE_BACKUPS_ENABLED=true
DATABASE_BACKUP_STORAGE=local
DATABASE_BACKUP_DIRECTORY=/backups
# For SFTP, set DATABASE_BACKUP_STORAGE=sftp and configure:
DATABASE_BACKUP_SFTP_HOST=
DATABASE_BACKUP_SFTP_PORT=22
DATABASE_BACKUP_SFTP_USERNAME=
DATABASE_BACKUP_SFTP_PASSWORD=
# Alternatively, provide a private key with escaped \n between lines.
DATABASE_BACKUP_SFTP_PRIVATE_KEY=
DATABASE_BACKUP_SFTP_PASSPHRASE=
# Verify the server host key, for example SHA256:base64-fingerprint.
DATABASE_BACKUP_SFTP_HOST_FINGERPRINT=
DATABASE_BACKUP_SFTP_DIRECTORY=/backups
DATABASE_BACKUP_RETENTION_DAYS=30
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
DATABASE_BACKUP_MAX_UPLOAD_BYTES=1073741824
DATABASE_BACKUP_TIMEOUT_MS=1800000

# Logging
LOG_RETENTION_MS=2592000000 # 30 * 24 * 60 * 60 * 1000
LOG_CLEANUP_INTERVAL_MS=86400000 # 24 * 60 * 60 * 1000

# Locales
VITE_NOVELTY=true