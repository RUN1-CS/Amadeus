# PostgreSQL
POSTGRES_IMAGE=pgvector/pgvector:pg17
POSTGRES_DB=amadeus
POSTGRES_USER=amadeus
POSTGRES_PASSWORD=change-this-password

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=4096

# ComfyUI
COMFYUI_BASE_URL=http://comfyui:8188
# Applied when a user leaves the negative prompt empty.
COMFYUI_DEFAULT_NEGATIVE_PROMPT=

# Port mappings (host ports)
SERVER_PORT=8080
WEB_PORT=3000

# PostgreSQL health check
POSTGRES_HEALTHCHECK_INTERVAL=5s
POSTGRES_HEALTHCHECK_TIMEOUT=5s
POSTGRES_HEALTHCHECK_RETRIES=10

WEBUI_ENABLE_AUTH=true
WEBUI_USERNAME=admin
WEBUI_PASSWORD=change-this-password