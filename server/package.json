{
  "name": "amadeus-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "npm run tools:install:dev && tsx watch index.ts",
    "start": "node dist/ai/tools/install.js && node dist/index.js",
    "tools:install": "node dist/ai/tools/install.js",
    "tools:install:dev": "tsx ai/tools/install.ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "busboy": "^1.6.0",
    "ollama": "^0.6.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "ssh2-sftp-client": "^12.1.1",
    "ws": "^8.23.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/ws": "^8.18.0",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
